{
  "name": "fleetvision",
  "version": "0.1.0",
  "private": true,
  "description": "FleetVision — Enterprise Fleet Management Platform (monorepo). Implements the architecture in docs/specs/01_Master_Architecture.md and ADR-021/022: Node.js LTS + NestJS + TypeScript, pnpm workspaces, Clean Architecture per service.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "dev": "pnpm --filter @fleetvision/identity-service dev",
    "dev:web": "pnpm --filter @fleetvision/web-dashboard dev",
    "build:web": "pnpm --filter @fleetvision/web-dashboard build",
    "test:web": "pnpm --filter @fleetvision/web-dashboard test",
    "test": "pnpm --workspace-concurrency=1 -r run test",
    "typecheck": "tsc -b tsconfig.json && pnpm -r run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "clean": "pnpm -r exec rimraf dist tsconfig.tsbuildinfo",
    "stack:up": "node tools/stack-up.mjs",
    "stack:down": "docker compose --project-name fleetvision -f infra/docker/docker-compose.yml down",
    "stack:reset": "node tools/stack-reset.mjs",
    "stack:logs": "docker compose --project-name fleetvision -f infra/docker/docker-compose.yml logs -f --tail=50",
    "stack:ps": "docker compose --project-name fleetvision -f infra/docker/docker-compose.yml ps",
    "seed:demo": "node tools/seed-demo.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "husky": "9.1.7",
    "lint-staged": "15.2.11",
    "rimraf": "6.0.1",
    "typescript": "5.6.3"
  }
}
