# --- Dependencies ---
node_modules/
.pnpm-store/

# --- Build output ---
dist/
build/
*.tsbuildinfo
tsconfig.tsbuildinfo
out/

# --- Test / coverage ---
coverage/
.nyc_output/
*.lcov

# --- Environment & secrets ---
# .env files MUST NEVER be committed. The .env under infra/docker/.env is the
# local dev template; copy infra/docker/.env.example to .env and edit.
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key

# --- IDE / OS ---
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.DS_Store
Thumbs.db
*.swp

# --- Docker ---
.docker/

# --- Logs ---
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# --- Cache ---
.cache/
.eslintcache
.parcel-cache/

# ZCode session artifacts (plans scratch, tokens — never commit)
.zcode/
