# Isolated linker = strict node_modules (no phantom deps) — the foundation of
# "one version of the DTO" enforceability (Codebase Architecture §3).
node-linker=isolated

# Resolve peer deps automatically (NestJS ecosystem relies on this).
auto-install-peers=true

# Pin exact versions; no semver drift sneaking in via patches.
save-exact=false

# Hoist only what's needed for native addons (ioredis/kafkajs have none today,
# but this keeps Docker build_reproducible across hosts).
public-hoist-pattern[]=*types*

# Faster installs + smaller footprint.
prefer-frozen-lockfile=true
