# FleetVision local dev environment.
# Copy this file to `infra/docker/.env` (git-ignored) and edit as needed.
# The compose stack and identity-service both read these values.

# --- Postgres (TimescaleDB + PostGIS) ---
POSTGRES_USER=fleetvision
POSTGRES_PASSWORD=fleetvision
POSTGRES_DB=fleetvision
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Kafka ---
KAFKA_PORT=9092

# --- RabbitMQ ---
RABBITMQ_USER=fleetvision
RABBITMQ_PASSWORD=fleetvision
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672

# --- MinIO (S3-API) ---
MINIO_ROOT_USER=fleetvision
MINIO_ROOT_PASSWORD=fleetvision-secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- identity-service connection strings (read by the service, not compose) ---
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
ENVIRONMENT=local
DBURL=postgres://fleetvision:fleetvision@localhost:5432/fleetvision
REDISURL=redis://localhost:6379/0

# --- JWT / auth (HS256 for MVP; migrate to RS256/JWKS + Vault later) ---
# JWT_AUDIENCE is standardized platform-wide (Sprint B) so one token verifies
# in every service. identity-service signs with the same audience.
JWT_ISSUER=fleetvision
JWT_AUDIENCE=fleetvision
# Generate with: openssl rand -hex 48   (must be >= 32 chars)
JWT_SECRET=replace-me-with-a-real-secret-at-least-32-chars-long
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=604800s

# --- Password hashing (Argon2id per Authentication.md §6.9) ---
ARGON2_MEMORY_KIB=65536
ARGON2_TIME=3
ARGON2_PARALLELISM=1
PASSWORD_MIN_LENGTH=12
PASSWORD_HISTORY_COUNT=5

# --- Brute-force lockout (AUTH-BR-03) ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# --- Kafka (audit outbox relay) ---
KAFKA_BROKERS=localhost:9092
KAFKA_AUDIT_TOPIC=fleetvision.audit.audit-entries.events
KAFKA_CLIENT_ID=identity-service

# --- Bootstrap seed (first tenant + admin) ---
SEED_TENANT_NAME=FleetVision
SEED_ADMIN_EMAIL=admin@fleetvision.local
SEED_ADMIN_PASSWORD=ChangeMe!StrongPass123

# --- device-gateway-service (registry #7; docs/specs/06_Device_Gateway.md) ---
# Admin HTTP port (health + admin API). Protocol TCP/UDP listeners open their own ports.
GATEWAY_ADMIN_PORT=8081
GATEWAY_HOST=0.0.0.0
# Comma-separated list of listeners to open at boot. Each entry is
# <adapterId>:<transport>:<port>, e.g. gt06:tcp:5016,stub:tcp:5099,gt06:udp:5016
GATEWAY_LISTENERS=gt06:tcp:5016,stub:tcp:5099
# Connection pool cap per pod (spec §5.1). When full the gateway stops accepting
# — back-pressure, not silent drop.
GATEWAY_MAX_CONNECTIONS=100000
# Idle timeout for TCP sockets in seconds (spec §12.2; TCP 180s default).
GATEWAY_TCP_IDLE_TIMEOUT_SECONDS=180
# Auth grace period: a NEW/IDENTIFY session older than this is closed (spec §12.4).
GATEWAY_AUTH_GRACE_SECONDS=10
# Data-liveness factor: a session is "stale" after 3x the reporting interval (spec §12.1).
GATEWAY_DATA_STALE_FACTOR=3
# Redis session TTL for UDP pseudo-sessions in seconds (spec §4.4; 2x report interval).
GATEWAY_UDP_SESSION_TTL_SECONDS=120
# Directory scanned for out-of-tree adapter plugins (spec §9.3). Empty disables.
GATEWAY_PLUGIN_DIR=
# Kafka producer (spec §13.2). Non-fatal at boot: the service starts even if
# Kafka is down and reconnects lazily.
GATEWAY_KAFKA_BROKERS=localhost:9092
GATEWAY_KAFKA_CLIENT_ID=device-gateway-service
GATEWAY_KAFKA_POSITION_TOPIC=fleetvision.telemetry.position.raw
GATEWAY_KAFKA_ALARM_TOPIC=fleetvision.telemetry.alarm.raw
GATEWAY_KAFKA_DEVICE_TOPIC=fleetvision.telemetry.device.raw
GATEWAY_KAFKA_SESSION_TOPIC=fleetvision.telemetry.session.lifecycle

# --- GPS Engine Service (07 §1.5, §13) ---
# Real-time position-processing tier: consumes positions from Kafka, persists to
# TimescaleDB, caches last-position in Redis, pushes WebSocket updates. Non-fatal
# at boot (07 §15.4): starts even with Kafka/Redis/PG down.
GPS_KAFKA_BROKERS=localhost:9092
GPS_KAFKA_CLIENT_ID=gps-engine-service
GPS_KAFKA_GROUP_ID=gps-engine-service
GPS_KAFKA_POSITION_TOPIC=fleetvision.telemetry.position.raw
GPS_KAFKA_SESSION_TOPIC=fleetvision.telemetry.session.lifecycle
GPS_WS_PORT=3001
GPS_WS_ENABLED=true
# Sprint B: comma-separated allowed CORS origins for the realtime WebSocket.
# Empty = no cross-origin browser clients. List the dashboard origin(s) here.
GPS_WS_CORS_ORIGIN=
GPS_REPORT_INTERVAL_SECONDS=60
GPS_STALE_AFTER_SECONDS=300
GPS_FUTURE_THRESHOLD_SECONDS=60
# TimescaleDB lifecycle for vehicle_positions (03 §11.1/§11.2). Applied at
# migration time; change later via alter_job or a follow-up migration.
GPS_POSITIONS_COMPRESS_AFTER_DAYS=7
GPS_POSITIONS_RETENTION_DAYS=180

# --- Map Engine Service (08 §1.5) ---
MAP_DEFAULT_PROVIDER=local
MAP_PROVIDER_REGION=global
MAPBOX_TOKEN=
OSRM_URL=
GOOGLE_MAPS_KEY=
MAP_CACHE_TTL_SECONDS=300
MAP_CLUSTER_CACHE_TTL_SECONDS=5
MAP_REPLAY_CACHE_TTL_SECONDS=600
MAP_CLUSTER_THRESHOLD=2000
MAP_MAX_CLUSTERS=100
