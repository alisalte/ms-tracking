# FleetVision local dev environment.
# Copy this file to `infra/docker/.env` (git-ignored) and edit as needed.
# The compose stack and identity-service both read these values.

# --- Postgres (TimescaleDB + PostGIS) ---
POSTGRES_USER=fleetvision
POSTGRES_PASSWORD=fleetvision
POSTGRES_DB=fleetvision
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Kafka ---
KAFKA_PORT=9092

# --- RabbitMQ ---
RABBITMQ_USER=fleetvision
RABBITMQ_PASSWORD=fleetvision
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672

# --- MinIO (S3-API) ---
MINIO_ROOT_USER=fleetvision
MINIO_ROOT_PASSWORD=fleetvision-secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- identity-service connection strings (read by the service, not compose) ---
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
ENVIRONMENT=local
DBURL=postgres://fleetvision:fleetvision@localhost:5432/fleetvision
REDISURL=redis://localhost:6379/0

# --- JWT / auth (HS256 for MVP; migrate to RS256/JWKS + Vault later) ---
JWT_ISSUER=fleetvision
JWT_AUDIENCE=fleetvision-identity
# Generate with: openssl rand -hex 48   (must be >= 32 chars)
JWT_SECRET=replace-me-with-a-real-secret-at-least-32-chars-long
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=604800s

# --- Password hashing (Argon2id per Authentication.md §6.9) ---
ARGON2_MEMORY_KIB=65536
ARGON2_TIME=3
ARGON2_PARALLELISM=1
PASSWORD_MIN_LENGTH=12
PASSWORD_HISTORY_COUNT=5

# --- Brute-force lockout (AUTH-BR-03) ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# --- Kafka (audit outbox relay) ---
KAFKA_BROKERS=localhost:9092
KAFKA_AUDIT_TOPIC=fleetvision.audit.audit-entries.events
KAFKA_CLIENT_ID=identity-service

# --- Bootstrap seed (first tenant + admin) ---
SEED_TENANT_NAME=FleetVision
SEED_ADMIN_EMAIL=admin@fleetvision.local
SEED_ADMIN_PASSWORD=ChangeMe!StrongPass123
