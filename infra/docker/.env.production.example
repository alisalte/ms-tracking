# FleetVision production env — copy to /opt/fleetvision/.env on the server.
# NEVER commit this file with real secrets.

# --- Images (set by CD; IMAGE_REGISTRY is ghcr.io/<owner>/<repo> lowercase) ---
IMAGE_REGISTRY=ghcr.io/example/ms06-clone-platform
IMAGE_TAG=main

# Public URL of the dashboard (no trailing slash). Used for Socket.IO CORS.
PUBLIC_ORIGIN=https://fleet.example.com

# --- Postgres ---
POSTGRES_USER=fleetvision
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=fleetvision
POSTGRES_APP_USER=fleetvision_app
POSTGRES_APP_PASSWORD=replace-with-a-long-random-password
POSTGRES_PLATFORM_USER=fleetvision_platform
POSTGRES_PLATFORM_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5432

# --- Redis / Kafka (bound to 127.0.0.1 in the prod overlay) ---
REDIS_PORT=6379
KAFKA_PORT=9092

# --- JWT (openssl rand -hex 48) ---
JWT_ISSUER=fleetvision
JWT_AUDIENCE=fleetvision-identity
JWT_SECRET=replace-me-with-a-real-secret-at-least-32-chars-long
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=604800s

# --- First-boot admin (change after login) ---
SEED_TENANT_NAME=FleetVision
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-password

# --- Device gateway ---
GATEWAY_MEITRACK_PORT=5023
GATEWAY_ADMIN_PORT=8081
FLEET_REGISTRY_API_KEY=

# --- MDVR live video (devices dial this host:port after A9A) ---
MDVR_VIDEO_PORT=6182
MDVR_MAX_STREAMS=32

# --- Dashboard publish port ---
WEB_PORT=8080

LOG_LEVEL=info
