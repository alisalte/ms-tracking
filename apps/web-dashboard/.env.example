VITE_API_BASE_URL=/api/v1
VITE_APP_TITLE=FleetVision

# Dev proxy targets (see vite.config.ts — one origin, no CORS):
VITE_API_PROXY_TARGET=http://localhost:3000
VITE_FLEET_API_PROXY_TARGET=http://localhost:3006
VITE_GPS_API_PROXY_TARGET=http://localhost:3005
VITE_NOTIFICATION_API_PROXY_TARGET=http://localhost:3008
VITE_FLEET_SVC_API_PROXY_TARGET=http://localhost:3007

# gps-engine WebSocket (Socket.IO — connects DIRECTLY, not via the proxy).
# The gps-engine must allow this origin via GPS_WS_CORS_ORIGIN.
VITE_GPS_WS_URL=http://localhost:3001

# Explicit development/demo data switch (default OFF — production is real-only).
VITE_USE_MOCK=false
