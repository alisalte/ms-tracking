{
  "name": "@fleetvision/identity-service",
  "version": "0.1.0",
  "private": true,
  "description": "FleetVision identity-service — authentication, authorization (RBAC), tenant provisioning, user/API-key management, and the hash-chained audit subsystem. Issues and verifies HS256 JWTs (shared with all services via @fleetvision/auth). Backed by PostgreSQL (RLS-enforced) and Redis (sessions/revocation/rate-limit).",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -b tsconfig.json && node -e \"require('node:fs').cpSync('src/infrastructure/database/migrations','dist/infrastructure/database/migrations',{recursive:true})\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "node --env-file=../../infra/docker/.env --watch --import tsx src/main.ts",
    "start": "node dist/main.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "dependencies": {
    "@fleetvision/auth": "workspace:*",
    "@fleetvision/cache-redis": "workspace:*",
    "@fleetvision/config": "workspace:*",
    "@fleetvision/health": "workspace:*",
    "@fleetvision/observability": "workspace:*",
    "@fleetvision/persistence-knex": "workspace:*",
    "@fleetvision/shared-kernel": "workspace:*",
    "@fleetvision/web": "workspace:*",
    "@nestjs/common": "10.4.15",
    "@nestjs/core": "10.4.15",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/platform-express": "10.4.15",
    "argon2": "0.41.1",
    "cookie-parser": "1.4.7",
    "kafkajs": "2.2.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@jest/globals": "29.7.0",
    "@testcontainers/postgresql": "10.16.0",
    "@types/cookie-parser": "1.4.7",
    "@types/express": "4.17.21",
    "@types/node": "22.10.2",
    "jest": "29.7.0",
    "testcontainers": "10.16.0",
    "ts-jest": "29.2.5",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  }
}
