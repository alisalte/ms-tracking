# Local E2E run env — services from source against the dockerized infra
# (postgres exposed on 15432, kafka 9092, redis 6379).
SERVICE_NAME=local-e2e
ENVIRONMENT=dev
LOG_LEVEL=debug

DBURL=postgres://fleetvision:fleetvision@localhost:15432/fleetvision
REDISURL=redis://localhost:6379/0

JWT_SECRET=dev-only-secret-please-override-in-production-0123456789abcdef
JWT_ISSUER=fleetvision
JWT_AUDIENCE=fleetvision-identity

# identity
# PORT set per-service

# fleet-management (started with its own overrides)
# GATEWAY_LISTENERS=meitrack:tcp:5023,stub:tcp:5099
GATEWAY_LISTENERS=meitrack:tcp:5023,stub:tcp:5099
GATEWAY_ADMIN_PORT=8081
GATEWAY_HOST=127.0.0.1
GATEWAY_KAFKA_BROKERS=localhost:9092
GATEWAY_KAFKA_CLIENT_ID=device-gateway-service
FLEET_REGISTRY_URL=http://localhost:3006
FLEET_REGISTRY_API_KEY=fv_live_3GosfKEKh4EHmj9-1WFmO_fjZXwrkXek
FLEET_KAFKA_BROKERS=localhost:9092
FLEET_KAFKA_CLIENT_ID=fleet-management-service
FLEET_KAFKA_GROUP_ID=fleet-management-service
