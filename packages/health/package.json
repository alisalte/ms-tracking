{
  "name": "@fleetvision/health",
  "version": "0.1.0",
  "private": true,
  "description": "FleetVision health checks — NestJS @nestjs/terminus-based /health/live (liveness, always 200) and /health/ready (readiness: PG ping via knex + Redis ping) per docs/specs/01_Master_Architecture.md §10.1 smoke-test contract.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "dependencies": {
    "@fleetvision/shared-kernel": "workspace:*",
    "@nestjs/common": "10.4.15",
    "@nestjs/core": "10.4.15",
    "@nestjs/terminus": "10.2.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1"
  },
  "peerDependencies": {
    "@fleetvision/persistence-knex": "workspace:*",
    "@fleetvision/cache-redis": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@fleetvision/persistence-knex": { "optional": true },
    "@fleetvision/cache-redis": { "optional": true }
  },
  "devDependencies": {
    "@fleetvision/cache-redis": "workspace:*",
    "@fleetvision/persistence-knex": "workspace:*",
    "@jest/globals": "29.7.0",
    "jest": "29.7.0",
    "ts-jest": "29.2.5",
    "typescript": "5.6.3"
  }
}
