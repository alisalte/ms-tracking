{
  "name": "@fleetvision/persistence-knex",
  "version": "0.1.0",
  "private": true,
  "description": "FleetVision persistence — knex client factory (PgBouncer-aware pool), BaseRepository, and migrations runner. No heavy ORM (ADR-021 §2.1); explicit, aggregate-aligned SQL.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "dependencies": {
    "@fleetvision/config": "workspace:*",
    "@fleetvision/observability": "workspace:*",
    "@fleetvision/shared-kernel": "workspace:*",
    "@nestjs/common": "10.4.15",
    "@nestjs/core": "10.4.15",
    "knex": "3.1.0",
    "pg": "8.13.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@jest/globals": "29.7.0",
    "@types/pg": "8.11.10",
    "jest": "29.7.0",
    "ts-jest": "29.2.5",
    "typescript": "5.6.3"
  }
}
