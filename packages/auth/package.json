{
  "name": "@fleetvision/auth",
  "version": "0.1.0",
  "private": true,
  "description": "FleetVision shared authentication & authorization primitives — the single source of truth for JWT/API-key guards, the authenticated context, the permission catalog, and tenant-switch validation. Consumed by identity-service and every downstream service so no service implements its own auth (Codebase Architecture §10).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "dependencies": {
    "@fleetvision/cache-redis": "workspace:*",
    "@fleetvision/persistence-knex": "workspace:*",
    "@fleetvision/shared-kernel": "workspace:*",
    "@fleetvision/web": "workspace:*",
    "@nestjs/common": "10.4.15",
    "@nestjs/core": "10.4.15",
    "@nestjs/jwt": "10.2.0",
    "argon2": "0.41.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@jest/globals": "29.7.0",
    "@types/express": "4.17.21",
    "jest": "29.7.0",
    "ts-jest": "29.2.5",
    "typescript": "5.6.3"
  }
}
