{
  "name": "@fleetvision/meitrack-media-protocol",
  "version": "0.1.0",
  "private": true,
  "description": "Meitrack MDVR media-plane protocol: binary 0x12 streaming packet parser (MDVR GPRS Protocol V2.0 §3.16) + GPRS text frame helpers. Shared by mdvr-streamer-service and the device simulator.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "devDependencies": {
    "@jest/globals": "29.7.0",
    "@types/node": "22.10.2",
    "jest": "29.7.0",
    "ts-jest": "29.2.5",
    "typescript": "5.7.2"
  }
}
